{
  "name": "dsh-customer-service-plugin",
  "version": "0.2.0",
  "description": "客服插件：DSH 里的点击式客服控制台。计划/话术模板/排班/队列、空闲时段批量预生成草稿，通过紫鸟CLI 操作 TikTok Shop 与 Walmart 店铺、通过飞书CLI 回复客服邮件；草稿先行，人工点发送。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "pack": "npm pack"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "customer-service",
    "ziniao",
    "lark"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
